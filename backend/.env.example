# ローカル開発の例（.env としてコピーして利用）
# DJANGO_DEBUG=true
# DJANGO_SECRET_KEY=ローカル用の任意の文字列
# DJANGO_ALLOWED_HOSTS=127.0.0.1

# 本番（必須）
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=ランダムな長い文字列
# DJANGO_ALLOWED_HOSTS=your-api.onrender.com,.onrender.com

# フロントが別ドメインのときのみ（カンマ区切り）。未設定なら CORS ミドルウェアは無効
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app

# LYNKOS_FRONTEND_DIST=/absolute/path/to/frontend/dist
# DJANGO_SECURE_SSL_REDIRECT=true
