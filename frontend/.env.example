# 本番・プレビュー: バックエンドのオリジン（末尾スラッシュなし）。分割デプロイでは必須推奨。
# VITE_BACKEND_ORIGIN=https://your-api.onrender.com
# 同一ホストで Django が SPA を配信する場合は未設定でよい（ページオリジンにフォールバック）

# 開発: Vite プロキシ先（backend の http(s) オリジン）。.env.development で既定済みのため通常は不要
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
# VITE_DEV_PORT=5173

# WebRTC: 既定で Google STUN。ここに TURN 等を JSON 配列で追加（既定 STUN に連結される）
# VITE_ICE_SERVERS_JSON=[{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
